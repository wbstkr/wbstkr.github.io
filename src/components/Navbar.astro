<nav class="navbar">
	<div class="nav-inner">
		<a href="/" class="brand">wbstkr.me</a>
		<div class="nav-links">
			<a href="#projects">Projects</a>
			<a href="#work">Work</a>
			<a href="#contact">Contact</a>
		</div>
	</div>
</nav>

<style>
	.navbar {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background: var(--color-bg);
		border-bottom: 2px solid var(--color-border);
	}

	.nav-inner {
		max-width: 680px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.brand {
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--color-text);
		text-decoration: none;
		letter-spacing: -0.02em;
		transition: color 0.15s ease;
	}

	.brand:hover {
		color: var(--color-accent);
	}

	.nav-links a {
		margin-left: 1.5rem;
		color: var(--color-text);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 600;
		transition: color 0.15s ease;
	}

	.nav-links a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}
</style>
