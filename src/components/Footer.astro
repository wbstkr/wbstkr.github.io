---
import { cleanPhone, contactInfo } from "../data/contact";
---

<footer id="contact" class="footer screen-only">
    <div class="footer-inner">
        <!-- Top row: Email • Phone # • Link1 • Link2 ... -->
        <div class="footer-line links-line">
            <a href={`mailto:${contactInfo.email}`}>Email</a>
            <span class="dot">&bull;</span>
            <a href={`tel:${cleanPhone}`}>{contactInfo.phone}</a>
            {
                contactInfo.links.map((link) => (
                    <>
                        <span class="dot">&bull;</span>
                        <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {link.simple}
                        </a>
                    </>
                ))
            }
        </div>

        <!-- Bottom row: Name • U.S. Citizen • Location -->
        <div class="footer-line meta-line">
            <span>{contactInfo.name}</span>
            <span class="dot">&bull;</span>
            <span>{contactInfo.citizenship}</span>
            <span class="dot">&bull;</span>
            <span>{contactInfo.location}</span>
        </div>
    </div>
</footer>

<style>
    .footer {
        width: 100%;
        margin-top: 2rem;
        border-top: 2px solid var(--color-border);
        padding: 3rem 0 4rem 0;
        display: flex;
        justify-content: center;
    }

    .footer-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.85rem;
    }

    .footer-line {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
    }

    /* Top line: Bold, prominent links without underlines */
    .links-line {
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .links-line a {
        color: var(--color-text);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .links-line a:hover {
        color: var(--color-accent);
    }

    /* Bottom line: Subtle metadata */
    .meta-line {
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--color-text);
    }

    .dot {
        user-select: none;
        font-size: 0.8rem;
        color: var(--color-text);
    }
</style>
