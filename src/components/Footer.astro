<footer id="contact" class="footer">
    <div class="footer-inner">
        <div class="links">
            <a href="https://github.com/wbstkr" target="_blank" rel="noreferrer"
                >GitHub</a
            >
            <span class="dot">&bull;</span>
            <a
                href="https://linkedin.com/in/wbstkr"
                target="_blank"
                rel="noreferrer">LinkedIn</a
            >
            <span class="dot">&bull;</span>
            <a href="mailto:ofaruque245@gmail.com">Email</a>
        </div>
        <div class="meta">
            <p>Omar Faruque &bull; NYC &bull; U.S. Citizen</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        border-top: 2px solid var(--color-border);
        background: var(--color-bg);
        padding: 3rem 1.5rem;
        color: var(--color-text);
    }

    .footer-inner {
        max-width: 680px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.85rem;
    }

    .links {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .links a {
        color: var(--color-text);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.95rem;
        transition: color 0.15s ease;
    }

    .links a:hover {
        color: var(--color-accent);
        text-decoration: underline;
    }

    .dot {
        color: var(--color-text);
        font-weight: 700;
    }

    .meta p {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-text);
    }
</style>
