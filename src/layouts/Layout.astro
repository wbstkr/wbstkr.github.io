---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Omar Faruque | Software Engineer",
	description = "Biochemistry STEM student bridging clinical data systems and backend software engineering in Java, Kotlin, and Python.",
} = Astro.props;

const canonicalURL = "https://wbstkr.me/";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />

		<!-- Open Graph / LinkedIn / Discord / Slack -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
	</head>
	<body>
		<Navbar />
		<main class="container">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #ffffff;
		--color-text: #000000;
		--color-border: #000000;
		--color-accent: #0000ff;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 4.5rem;
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			Roboto,
			sans-serif;
		color: var(--color-text);
		background: var(--color-bg);
		line-height: 1.5;
	}

	body {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	/* Sharp, boxy focus outlines */
	a:focus-visible,
	button:focus-visible,
	input:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
		border-radius: 0 !important;
	}

	/* Screen utility rules */
	.print-only {
		display: none !important;
	}

	/* =========================================================
     PRINT RESUME STYLES (Triggers on window.print or Ctrl/Cmd+P)
     ========================================================= */
	@media print {
		@page {
			size: letter portrait;
			margin: 0.5in 0.6in;
		}

		/* Prevent 100vh flex containers from forcing a blank page */
		html,
		body {
			height: auto !important;
			min-height: 0 !important;
			margin: 0 !important;
			padding: 0 !important;
			background: #ffffff !important;
			color: #000000 !important;
			font-size: 9.5pt !important;
			line-height: 1.35 !important;
		}

		.container {
			max-width: 100% !important;
			padding: 0 !important;
			margin: 0 !important;
			min-height: 0 !important;
			flex: none !important;
		}

		/* Visibility overrides: ensure hidden items take 0 DOM layout height */
		.hide-on-print,
		.screen-only,
		.navbar,
		.footer,
		footer {
			display: none !important;
			height: 0 !important;
			margin: 0 !important;
			padding: 0 !important;
			overflow: hidden !important;
		}

		.print-only {
			display: block !important;
		}

		li.print-only {
			display: list-item !important;
		}

		/* Print Header & Contact Info */
		.hero h1 {
			font-size: 20pt !important;
			font-weight: 800 !important;
			margin: 0 0 2pt 0 !important;
			text-align: left;
		}

		.print-contact {
			font-size: 8.5pt !important;
			font-weight: 500 !important;
			margin-bottom: 8pt !important;
			border-bottom: 1px solid #000000 !important;
			padding-bottom: 4pt !important;
			color: #000000 !important;
		}

		.print-contact a {
			color: #000000 !important;
			text-decoration: none !important;
			border-bottom: none !important;
		}

		/* Section Headings */
		.section-title,
		.print-section-title {
			font-size: 11pt !important;
			font-weight: 700 !important;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			border-bottom: 1px solid #000000;
			margin: 6pt 0 3pt 0 !important;
			padding-bottom: 1pt;
		}

		/* Section & Item Spacing */
		.section {
			margin-bottom: 5pt !important;
		}

		/* Strip bottom margin on the final section to keep print strictly 1 page */
		section:last-of-type,
		.section:last-child {
			margin-bottom: 0 !important;
			padding-bottom: 0 !important;
		}

		.job,
		.project-item,
		.project-card,
		.education-entry,
		.skills-section {
			margin-bottom: 4pt !important;
			break-inside: avoid;
			page-break-inside: avoid;
		}

		.job-header {
			display: flex;
			justify-content: space-between;
			font-weight: 700;
			font-size: 9.5pt !important;
		}

		.job-header .position {
			font-size: 9.5pt !important;
			font-weight: 700 !important;
			margin: 0 !important;
		}

		.job-header .year {
			font-size: 9pt !important;
			font-weight: 600 !important;
			background: transparent !important;
			color: #000 !important;
			padding: 0 !important;
			border: none !important;
		}

		.company {
			font-size: 9pt !important;
			font-style: italic;
			margin: 1pt 0 2pt 0 !important;
		}

		/* Remove cards/boxes from projects */
		.project-card {
			border: none !important;
			padding: 0 !important;
			box-shadow: none !important;
			margin: 0 0 4pt 0 !important;
			background: transparent !important;
			transform: none !important;
		}

		.project-card h3 {
			font-size: 9.5pt !important;
			font-weight: 700 !important;
			margin: 0 0 2pt 0 !important;
		}

		.project-card p {
			font-size: 9pt !important;
			margin: 0 !important;
		}

		.project-card a {
			display: none !important;
		}

		/* Bullet lists */
		ul {
			margin: 2pt 0 0 14pt !important;
			padding: 0 !important;
		}

		li {
			font-size: 9pt !important;
			margin-bottom: 1.5pt !important;
			line-height: 1.3 !important;
		}

		.print-bullets {
			margin: 2pt 0 0 14pt !important;
			padding: 0 !important;
		}

		.print-bullets li {
			font-size: 9pt !important;
			line-height: 1.35 !important;
			margin-bottom: 2pt !important;
			color: #000000 !important;
		}

		.pipe {
			font-size: 9pt !important;
			color: #000000 !important;
			margin: 0 3pt !important;
			user-select: none !important;
		}

		/* Skills block formatting */
		.skills-grid p {
			font-size: 9pt !important;
			margin: 1pt 0 !important;
			line-height: 1.3 !important;
		}

		.stuyvesant-line h3 {
			font-size: 9pt !important;
			font-weight: normal !important;
			margin-top: 2pt !important;
		}
	}
</style>

<style>
	.container {
		max-width: 680px;
		width: 100%;
		margin: 0 auto;
		padding: 2.5rem 1.5rem 4rem 1.5rem;
		flex: 1;
	}
</style>
